{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "Sada",
  "description": "__MSG_appDesc__",
  "version": "0.8.5",
  "default_locale": "en",
  "homepage_url": "https://getayka.com/sada/",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "contextMenus",
    "alarms",
    "favicon"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_actionTitle__"
    },
    "send-answer": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "__MSG_sendAnswer__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "optional_permissions": [
    "notifications",
    "clipboardRead"
  ],
  "storage": {
    "managed_schema": "schema.json"
  }
}